{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Identity": {
    "Audience": "commerce-api"
  },
  "RateLimits": {
    "AnonymousPerMinute": 60,
    "UserPerMinute": 300,
    "OrdersPerMinute": 10
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-browse": {
        "ClusterId": "api",
        "Order": 1,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "anonymous",
        "Match": { "Path": "/api/catalog/products", "Methods": [ "GET" ] }
      },
      "catalog-product": {
        "ClusterId": "api",
        "Order": 1,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "anonymous",
        "Match": { "Path": "/api/catalog/products/{id:guid}", "Methods": [ "GET" ] }
      },
      "order-placement": {
        "ClusterId": "api",
        "Order": 1,
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "order-placement",
        "Match": { "Path": "/api/orders", "Methods": [ "POST" ] }
      },
      "reports": {
        "ClusterId": "reporting-worker",
        "Order": 5,
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "user",
        "Match": { "Path": "/api/reports/{**rest}" }
      },
      "audit": {
        "ClusterId": "audit-worker",
        "Order": 5,
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "user",
        "Match": { "Path": "/api/audit/{**rest}" }
      },
      "notifications": {
        "ClusterId": "notification-worker",
        "Order": 5,
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "user",
        "Match": { "Path": "/api/notifications/{**rest}" }
      },
      "api": {
        "ClusterId": "api",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "user",
        "Match": { "Path": "/api/{**rest}" }
      }
    },
    "Clusters": {
      "api": { "Destinations": { "primary": { "Address": "http://commerce-api:8080" } } },
      "reporting-worker": { "Destinations": { "primary": { "Address": "http://reporting-worker:8080" } } },
      "audit-worker": { "Destinations": { "primary": { "Address": "http://audit-worker:8080" } } },
      "notification-worker": { "Destinations": { "primary": { "Address": "http://notification-worker:8080" } } }
    }
  }
}
